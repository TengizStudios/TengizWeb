---
import Layout from '../layouts/Layout.astro';
const {toggleLayout = true} = Astro.props;
import "7.css/dist/7.scoped.css";
---

{toggleLayout && <Layout />}

<div id="register-page">
    <div class="win7">
    
    <div class="window active" style="max-width: 900px">
    <div class="title-bar">
        <div class="title-bar-text">Register account</div>
        <div class="title-bar-controls">
        <button aria-label="Minimize"></button>
        <button aria-label="Maximize" disabled></button>
        <button aria-label="Close"></button>
        </div>
    </div>
    <div class="window-body has-space">
        
        <h1>Register Account</h1>
        <div class="group" style="width: 300px">
        <label for="username">Username</label>
        <input id="username" type="text" />

        </div>
        <div class="group" style="width: 300px">
        <label for="email">Email address (Optional)</label>
        <input id="email" type="text" />
        </div>

        <div class="group" style="width: 300px">
        <label for="password">Password</label>
        <input id="password" 
        type="password"     
        spellcheck="false"
        autocapitalize="off"
        autocomplete="new-password"
        style="ime-mode: disabled;"
        lang="en"
        />
        </div>
        <div class="group" style="width: 300px">

        <label for="cpass">Comfirm password</label>
        <input id="cpass" 
        type="password"     
        spellcheck="false"
        autocapitalize="off"
        autocomplete="new-password"
        style="ime-mode: disabled;"
        lang="en"
        />
        </div>

        <br />

        <section style="display: flex; justify-content: flex-end; gap: 6px">
            <button>Register!</button>
        </section>
    </div>
    </div>
    </div>

</div>


<style>
    #register-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .form {
        display: flex;
        border-radius: 15px;
        padding: 25px;
        box-sizing: border-box;
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
        color: #fafafa;
        background: linear-gradient(180deg, rgba(83, 85, 87, 0.5) 0%, rgba(14, 15, 15, 0.8) 100%);
        backdrop-filter: blur(10px);
        box-shadow: 0px 10px 15px rgba(0, 0, 0, 0.3), inset 0px 2px 1px rgba(255, 255, 255, 0.3), inset 0px -2px 1px rgba(0, 0, 0, 0.4);

    }


    .button-links-inactive:hover::before {
        opacity: 1;
    }

    .button-links-inactive::before {
        content: "";
        position: absolute;
        inset: 0;

        background: linear-gradient( 180deg, rgba(127, 140, 124, 0) 30%, rgba(216, 223, 212, 0.4) 100% );

        opacity: 0;
        transition: opacity 0.2s ease-in;

        z-index: 1;
    }

    .top-links-container a {
        box-shadow: 0px 6px 15px rgba(0, 0, 0, 0.3), inset 0px 2px 1px rgba(255, 255, 255, 0.3), inset 0px -2px 1px rgba(0, 0, 0, 0.4);
        border-radius: 4px;

        justify-content: flex-start;
        width: 100%;
        height: 75px;
        font-size: 1.4em;
        padding: 0px 10px;

        margin: 5px 4px;

        z-index: 1;
    }
    .buttons-no-underline a {
    text-decoration: none;
    }

    a:hover {
        color: rgba(223, 223, 223, 0.9);
        text-decoration: underline;
        transition-duration: 0.2s;
    }

    .button-links-inactive {
        position: relative;
        background: linear-gradient( 180deg, rgba(180, 188, 190, 0.4) 0%, rgba(107, 115, 119, 0.4) 50%, rgba(61, 65, 67, 0.014) 50.1% );

        transition: all 0.2s ease-in;

            transition-duration: 0.2s;

        overflow: hidden;

    }
    .button-links-active, .button-links-inactive {
        flex-direction: row;
        gap: 7px;

        height: 100%;
        font-size: 1.2em;
        font-weight: 250;
        cursor: pointer;
    }

    .flex-center {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    a {
    color: rgba(255, 255, 255, 0.9);
    transition-duration: 0.2s;
    }

    
</style>