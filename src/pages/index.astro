<script>
	let currentSlide = 0;

	setInterval(() => {
		currentSlide++;

		if (currentSlide >= 2) {
			currentSlide = 0;
		}

		const track = document.querySelector<HTMLElement>(".track");

		if (track) {
			track.style.transform = `translateX(-${currentSlide * 100}%)`;
		}
	}, 5000);
</script>

<style>
	main {
		color: yellow;
		text-align: center;
	}
	p {
		padding-left:  25px;
		padding-right:  5px;
		color :rgb(141, 211, 211)
	}
	#upd1 {
		color : rgb(233, 173, 173);
	}

	.carousel {
		width: 100%;
		height: calc(100vh - 90px);
		overflow: hidden;
	}

	.track {
		display: flex;
		width: 100%;
		height: 100%;
		transition: transform 0.6s ease;
	}

	.track img {
		flex: 0 0 100%;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>

