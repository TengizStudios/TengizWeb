<script>
	let currentSlide = 0;

	const track = document.querySelector<HTMLElement>(".track");
	const btn1 = document.querySelector<HTMLButtonElement>("#btn1");
	const btn2 = document.querySelector<HTMLButtonElement>("#btn2");

	setInterval(() => {
		currentSlide++;

		if (currentSlide >= 2) {
			currentSlide = 0;
		}

		if (track) {
			track.style.transform = `translateX(-${currentSlide * 100}%)`;
		}
	}, 5000);

	function goToSlide(index: number) {
		currentSlide = index;

		if (track) {
			track.style.transform = `translateX(-${currentSlide * 100}%)`;
		}
	}

	btn1?.addEventListener("click", () => goToSlide(0));
	btn2?.addEventListener("click", () => goToSlide(1));
</script>

<style>
	.content {
		padding-top: 20px;
		padding-bottom: 50px;
		max-width: 80vw;
		margin-inline: auto; /* Modern equivalent to margin: 0 auto */
	}
	h1 {
		color: white;
	}
	main {
		color: yellow;
		text-align: center;
	}
	p {
		padding-left: 25px;
		padding-right: 5px;
		color: rgb(141, 211, 211);
	}
	#upd1 {
		color: rgb(233, 173, 173);
	}

	.carousel {
		width: 100%;
		height: calc(100vh - 90px);
		overflow: hidden;
		position: relative;
	}

	.track {
		display: flex;
		width: 100%;
		height: 100%;
		transition: transform 0.6s ease;
	}

	#hero1,
	#hero2 {
		flex: 0 0 100%;
		width: 100%;
		height: 100%;
		position: relative;
	}

	.hero-btn {
		border: none;
		border-radius: 100%;
		padding: 5px;
	}

	#c-button {
		position: absolute;
		bottom: 30px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 99;

		display: flex;
		gap: 10px;
	}

	.hero-text {
		position: absolute;
		z-index: 98;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		color: white;
		font-size: 300%;
	}

	#hero-image1,
	#hero-image2 {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
</style>
