---
const { title = "Tengiz" } = Astro.props;
import background from "../assets/background.jpg";
import Header from '../components/Header.astro';
import Analytics from '@vercel/analytics/astro';
import Sidebar from '../components/Sidebar.astro';
import SpeedInsights from "@vercel/speed-insights/astro"

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/TengizLogo3.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
	</head>
	<!-- <body style={`background-image:url(${background.src}); background-size: cover`}> -->
	<body>

		
		<Analytics />
		<SpeedInsights/>
		<Header />
		<!-- <Sidebar /> -->
		<slot />
	</body>
</html>

<style>
	@font-face {
        font-family: Noto;
        src: url(../assets/fonts/NotoSans-VariableFont_wdth\,wght.ttf);
    }
	html,
	body {
		background: url("//b.thumbs.redditmedia.com/XEAgzel0nBgi78G_smcsyiERgMyknA0DlmQ368kYA8k.png") no-repeat center center fixed!important;
		background-size: cover!important;
		font-family: "Nunito", sans-serif;
		font-optical-sizing: auto;
		font-style: normal;

		/* background-image: url(../assets/test.png);
		background-size: 64px; */
		/* background: linear-gradient(#1f1f31,#4c4c79); So over here is Background of the main page */
		margin: 0;
		width: 100%;
		height: 100%;
	}
	
</style>


